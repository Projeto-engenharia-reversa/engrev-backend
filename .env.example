SECRET_KEY=troque-esta-chave
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
# Em Docker o compose injeta o endereço do contêiner; este valor é para uso local
DATABASE_URL=postgresql+psycopg://engrev:engrev@localhost/engrev
CORS_ORIGINS=["http://localhost:4200"]
# "mock" roda sem rede e sem custo; "gemini" usa o provedor real
LLM_PROVIDER=mock
API_KEY=
# Modelo forte (modelagem) e leve (revisão da validação).
LLM_MODEL=gemini-3.6-flash
LLM_MODEL_LIGHT=gemini-3.5-flash-lite
# Plural quando o código não declara nome de tabela: en | pt | none
NAMING_PLURAL=en
# Orçamento de saída por chamada
MAX_OUTPUT_TOKENS=64000
MAX_OUTPUT_TOKENS_LIGHT=8000
MAX_UPLOAD_SIZE_MB=20
TOKEN_BUDGET=200000
# Acima de 1, consolida por maioria ao custo de uma chamada por amostra
AMOSTRAS_MODELAGEM=1
SEED_ADMIN_EMAIL=admin@engrev.dev
SEED_ADMIN_PASSWORD=admin123
